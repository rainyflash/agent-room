FROM rust:1.97.1-bookworm AS builder

WORKDIR /source
COPY . .
RUN cargo build --locked --release \
    --package agent-room-control-plane \
    --package agent-room-postgres-adapter \
    --package agent-room-content-adapter \
    --bin agent-room-control-plane \
    --bin migrate \
    --bin provision_bucket

FROM debian:bookworm-slim AS runtime

RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 --no-create-home --shell /usr/sbin/nologin agent-room
COPY --from=builder /source/target/release/agent-room-control-plane /usr/local/bin/agent-room-control-plane
COPY --from=builder /source/target/release/migrate /usr/local/bin/agent-room-migrate
COPY --from=builder /source/target/release/provision_bucket /usr/local/bin/agent-room-provision-bucket
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/agent-room-control-plane"]
