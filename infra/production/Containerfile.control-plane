FROM rust:1.97.1-bookworm AS builder

WORKDIR /source
# 运维脚本、文档和证据不属于 Rust 产物输入；隔离构建边界，避免无关改动击穿缓存。
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY apps ./apps
COPY crates ./crates
COPY infra/migrations ./infra/migrations
RUN --mount=type=cache,id=agent-room-cargo-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=agent-room-control-plane-target,target=/source/target \
    cargo build --locked --release \
    --package agent-room-control-plane \
    --package agent-room-postgres-adapter \
    --package agent-room-content-adapter \
    --bin agent-room-control-plane \
    --bin migrate \
    --bin provision_bucket \
    && install -Dm755 target/release/agent-room-control-plane /out/agent-room-control-plane \
    && install -Dm755 target/release/migrate /out/migrate \
    && install -Dm755 target/release/provision_bucket /out/provision_bucket

FROM debian:bookworm-slim AS runtime

RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 --no-create-home --shell /usr/sbin/nologin agent-room
COPY --from=builder /out/agent-room-control-plane /usr/local/bin/agent-room-control-plane
COPY --from=builder /out/migrate /usr/local/bin/agent-room-migrate
COPY --from=builder /out/provision_bucket /usr/local/bin/agent-room-provision-bucket
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/agent-room-control-plane"]
