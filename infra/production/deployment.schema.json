{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-room.example/schemas/production-deployment-v1.json",
  "title": "Agent Room production deployment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectName",
    "public",
    "database",
    "objectStore",
    "capacity",
    "backup",
    "telemetry"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "projectName": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{2,62}$"
    },
    "public": {
      "type": "object",
      "additionalProperties": false,
      "required": ["serverName", "appDomain", "apiDomain", "matrixDomain", "identityDomain"],
      "properties": {
        "serverName": { "$ref": "#/$defs/dnsName" },
        "appDomain": { "$ref": "#/$defs/dnsName" },
        "apiDomain": { "$ref": "#/$defs/dnsName" },
        "matrixDomain": { "$ref": "#/$defs/dnsName" },
        "identityDomain": { "$ref": "#/$defs/dnsName" },
        "acmeEmail": { "type": "string", "format": "email", "maxLength": 254 }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["embedded", "external"] },
        "host": { "type": "string", "minLength": 1, "maxLength": 253 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "tlsMode": {
          "enum": ["disable", "prefer", "require", "verify-ca", "verify-full"]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "external" } } },
          "then": {
            "required": ["host", "tlsMode"],
            "properties": {
              "tlsMode": { "enum": ["require", "verify-ca", "verify-full"] }
            }
          }
        }
      ]
    },
    "objectStore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["embedded", "external"] },
        "endpoint": { "type": "string", "format": "uri", "maxLength": 1024 },
        "healthUrl": { "type": "string", "format": "uri", "maxLength": 1024 },
        "bucket": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*[a-z0-9]$",
          "maxLength": 63
        },
        "region": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "external" } } },
          "then": { "required": ["endpoint", "healthUrl"] }
        }
      ]
    },
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controlPlaneReplicas", "synapseWorkers"],
      "properties": {
        "controlPlaneReplicas": { "type": "integer", "minimum": 1, "maximum": 16 },
        "synapseWorkers": { "type": "integer", "minimum": 0, "maximum": 8 }
      }
    },
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "retentionDays", "rpoMinutes"],
      "properties": {
        "repository": { "$ref": "#/$defs/absoluteHostPath" },
        "retentionDays": { "type": "integer", "minimum": 7, "maximum": 365 },
        "recentRetentionHours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 168,
          "default": 24
        },
        "rpoMinutes": { "type": "integer", "minimum": 1, "maximum": 15 },
        "providerPitrEvidenceFile": { "$ref": "#/$defs/absoluteHostPath" }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "alertWebhookUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 1024
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "enabled": { "const": true } },
            "required": ["enabled"]
          },
          "then": { "required": ["alertWebhookUrl"] },
          "else": { "not": { "required": ["alertWebhookUrl"] } }
        }
      ]
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "registration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": { "enum": ["closed", "open-email"] },
            "smtp": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "host",
                "port",
                "fromAddress",
                "fromDisplayName",
                "username",
                "encryption",
                "passwordFile"
              ],
              "properties": {
                "host": { "type": "string", "minLength": 1, "maxLength": 253 },
                "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
                "fromAddress": { "type": "string", "format": "email", "maxLength": 254 },
                "fromDisplayName": { "type": "string", "minLength": 1, "maxLength": 1024 },
                "username": { "type": "string", "minLength": 1, "maxLength": 1024 },
                "encryption": { "enum": ["starttls", "ssl"] },
                "passwordFile": { "$ref": "#/$defs/absoluteHostPath" }
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": { "mode": { "const": "open-email" } },
                "required": ["mode"]
              },
              "then": { "required": ["smtp"] },
              "else": { "not": { "required": ["smtp"] } }
            }
          ]
        }
      }
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "windowsDownloadUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 2048
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "database": {
            "properties": { "mode": { "const": "external" } },
            "required": ["mode"]
          }
        }
      },
      "then": {
        "properties": {
          "backup": { "required": ["providerPitrEvidenceFile"] }
        }
      },
      "else": {
        "properties": {
          "backup": {
            "not": { "required": ["providerPitrEvidenceFile"] }
          }
        }
      }
    }
  ],
  "$defs": {
    "dnsName": {
      "type": "string",
      "pattern": "^(?=.{1,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "absoluteHostPath": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^/(?!$)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$",
          "maxLength": 1024
        },
        {
          "type": "string",
          "pattern": "^[A-Za-z]:[\\\\/](?!$)(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$))[^\\u0000]+$",
          "maxLength": 1024
        }
      ]
    }
  }
}
