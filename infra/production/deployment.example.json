{
  "$schema": "./deployment.schema.json",
  "schemaVersion": 1,
  "projectName": "agent-room",
  "public": {
    "serverName": "agent-room.example",
    "appDomain": "app.agent-room.example",
    "apiDomain": "api.agent-room.example",
    "matrixDomain": "matrix.agent-room.example",
    "identityDomain": "id.agent-room.example"
  },
  "database": {
    "mode": "embedded",
    "port": 5432,
    "tlsMode": "disable"
  },
  "objectStore": {
    "mode": "embedded",
    "bucket": "agent-room-content",
    "region": "us-east-1"
  },
  "capacity": {
    "controlPlaneReplicas": 1,
    "synapseWorkers": 0
  },
  "backup": {
    "repository": "/var/backups/agent-room",
    "retentionDays": 30,
    "recentRetentionHours": 24,
    "rpoMinutes": 15
  },
  "identity": {
    "registration": {
      "mode": "closed"
    }
  },
  "distribution": {},
  "telemetry": {
    "enabled": true,
    "alertWebhookUrl": "https://alerts.agent-room.example/v1/events"
  }
}
