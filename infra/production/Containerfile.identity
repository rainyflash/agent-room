FROM quay.io/keycloak/keycloak:26.7.2 AS builder

ENV KC_DB=postgres
ENV KC_HEALTH_ENABLED=true
ENV KC_METRICS_ENABLED=true
RUN /opt/keycloak/bin/kc.sh build

FROM quay.io/keycloak/keycloak:26.7.2
COPY --from=builder /opt/keycloak/ /opt/keycloak/
COPY --chown=keycloak:keycloak --chmod=755 infra/production/keycloak-entrypoint.sh /opt/keycloak/bin/agent-room-entrypoint.sh
ENTRYPOINT ["/opt/keycloak/bin/agent-room-entrypoint.sh"]
