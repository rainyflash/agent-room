FROM rust:1.97.1-bookworm AS builder
WORKDIR /source
RUN apt-get update && apt-get install --yes --no-install-recommends libdbus-1-dev pkg-config \
    && rm -rf /var/lib/apt/lists/*
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY apps ./apps
COPY crates ./crates
RUN --mount=type=cache,id=agent-room-cargo-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=agent-room-agent-runtime-target,target=/source/target \
    cargo build --locked --release -p agent-room-bridge -p agent-room-mcp -p agent-room-cli \
    && install -Dm755 target/release/agent-room-bridge /out/agent-room-bridge \
    && install -Dm755 target/release/agent-room-mcp /out/agent-room-mcp \
    && install -Dm755 target/release/agent-room /out/agent-room

FROM debian:bookworm-slim AS runtime
RUN apt-get update && apt-get install --yes --no-install-recommends ca-certificates libdbus-1-3 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 --no-create-home --shell /usr/sbin/nologin agent-room
COPY --from=builder /out/ /usr/local/bin/
USER 10001:10001
CMD ["agent-room-bridge"]
