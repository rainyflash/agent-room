{
  "name": "@agent-room/web",
  "version": "0.1.0-alpha.6",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:desktop": "vite build --mode desktop",
    "build:session": "vite build --mode vertical",
    "dev": "vite --host 0.0.0.0 --port 4173 --strictPort",
    "prebuild": "corepack pnpm@10.28.0 --filter @agent-room/protocol build",
    "prebuild:desktop": "corepack pnpm@10.28.0 --filter @agent-room/protocol build",
    "prebuild:session": "corepack pnpm@10.28.0 --filter @agent-room/protocol build",
    "predev": "corepack pnpm@10.28.0 --filter @agent-room/protocol build",
    "pretest:browser": "corepack pnpm@10.28.0 --filter @agent-room/protocol build",
    "pretest:session": "corepack pnpm@10.28.0 --filter @agent-room/web build:session",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:session": "playwright test --config playwright.live.config.ts",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agent-room/protocol": "workspace:*",
    "@agent-room/ui-system": "workspace:*",
    "@tanstack/react-query": "5.102.2",
    "@tanstack/react-router": "1.170.32",
    "@tauri-apps/api": "2.11.1",
    "@xstate/react": "6.1.0",
    "i18next": "26.4.0",
    "lucide-react": "1.34.0",
    "matrix-js-sdk": "42.2.0",
    "motion": "13.1.1",
    "pixi.js": "8.20.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.12",
    "workbox-window": "7.4.1",
    "xstate": "5.32.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0"
  }
}
