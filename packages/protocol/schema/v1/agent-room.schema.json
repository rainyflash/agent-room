{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentroom.example/v1/agent-room.schema.json",
  "title": "AgentRoomProtocolV1",
  "oneOf": [
    { "$ref": "#/$defs/ErrorEnvelope" },
    { "$ref": "#/$defs/CapabilityManifest" },
    { "$ref": "#/$defs/MessagePreviewEvent" },
    { "$ref": "#/$defs/MessagePreviewEventV2" },
    { "$ref": "#/$defs/MessageRevisionEvent" },
    { "$ref": "#/$defs/MessageRevisionEventV2" },
    { "$ref": "#/$defs/ModerationNoticeEvent" },
    { "$ref": "#/$defs/AgentStatusEvent" },
    { "$ref": "#/$defs/HandoffRequestEvent" },
    { "$ref": "#/$defs/HandoffReceiptEvent" }
  ],
  "$defs": {
    "ErrorCategory": {
      "type": "string",
      "enum": [
        "validation",
        "authentication",
        "authorization",
        "conflict",
        "transient",
        "unknown_commit",
        "dependency_unavailable",
        "incompatible_version"
      ]
    },
    "Provenance": {
      "type": "string",
      "enum": ["human", "human_confirmed_agent", "autonomous_agent"]
    },
    "AgentProvenance": {
      "type": "string",
      "enum": ["human_confirmed_agent", "autonomous_agent"]
    },
    "MessageSensitivity": {
      "type": "string",
      "enum": ["normal", "sensitive", "restricted"]
    },
    "MessageRevisionKind": {
      "type": "string",
      "enum": ["replace", "redact", "moderate"]
    },
    "AgentStatusVisibility": {
      "type": "string",
      "enum": ["coarse", "detailed"]
    },
    "AgentWorkStatus": {
      "type": "string",
      "enum": ["offline", "idle", "working", "waiting_input", "blocked", "completed"]
    },
    "HandoffPermission": {
      "type": "string",
      "enum": ["read_text", "read_attachments", "include_metadata"]
    },
    "HandoffPurpose": {
      "type": "string",
      "enum": ["inspect", "summarize", "reply_draft"]
    },
    "HandoffReceiptStatus": {
      "type": "string",
      "enum": ["delivered", "consumed", "declined", "revoked", "expired", "failed"]
    },
    "AgentRef": {
      "type": "object",
      "required": ["agentId", "displayName", "matrixUserId"],
      "properties": {
        "agentId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "matrixUserId": {
          "type": "string",
          "minLength": 4,
          "maxLength": 255,
          "pattern": "^@[^:]+:[^:]+$"
        },
        "avatarUrl": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^https://"
        }
      },
      "additionalProperties": true,
      "maxProperties": 16
    },
    "ActorRef": {
      "type": "object",
      "required": ["agent", "instanceId", "provenance"],
      "properties": {
        "agent": { "$ref": "#/$defs/AgentRef" },
        "instanceId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "provenance": { "$ref": "#/$defs/Provenance" }
      },
      "additionalProperties": true,
      "maxProperties": 12
    },
    "HumanActor": {
      "type": "object",
      "required": ["kind", "principalId", "displayName", "matrixUserId"],
      "properties": {
        "kind": { "const": "human" },
        "principalId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "matrixUserId": {
          "type": "string",
          "minLength": 4,
          "maxLength": 255,
          "pattern": "^@[^:]+:[^:]+$"
        },
        "avatarUrl": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^https://"
        }
      },
      "additionalProperties": true,
      "maxProperties": 12
    },
    "AgentActor": {
      "type": "object",
      "required": ["kind", "agent", "instanceId", "provenance"],
      "properties": {
        "kind": { "const": "agent" },
        "agent": { "$ref": "#/$defs/AgentRef" },
        "instanceId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "provenance": { "$ref": "#/$defs/AgentProvenance" }
      },
      "additionalProperties": true,
      "maxProperties": 12
    },
    "Actor": {
      "oneOf": [{ "$ref": "#/$defs/HumanActor" }, { "$ref": "#/$defs/AgentActor" }]
    },
    "HandoffSource": {
      "type": "object",
      "required": ["roomId", "eventId", "messageId", "actor"],
      "properties": {
        "roomId": {
          "type": "string",
          "minLength": 4,
          "maxLength": 255,
          "pattern": "^![^:]+:[^:]+$"
        },
        "eventId": {
          "type": "string",
          "minLength": 4,
          "maxLength": 512,
          "pattern": "^\\$[^\\u0000-\\u001F\\u007F]+$"
        },
        "messageId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "actor": { "$ref": "#/$defs/ActorRef" }
      },
      "additionalProperties": true,
      "maxProperties": 12
    },
    "ContentRef": {
      "type": "object",
      "required": ["contentId", "digestSha256", "sizeBytes", "mediaType", "fetchMode"],
      "properties": {
        "contentId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "digestSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 26214400
        },
        "mediaType": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$"
        },
        "encryption": { "$ref": "#/$defs/ClientContentEncryption" },
        "fetchMode": { "const": "on_demand" }
      },
      "propertyNames": {
        "not": { "enum": ["downloadUrl", "url"] }
      },
      "additionalProperties": true,
      "maxProperties": 16
    },
    "ClientContentEncryption": {
      "type": "object",
      "required": [
        "algorithm",
        "contextId",
        "keyBase64Url",
        "nonceBase64Url",
        "plaintextSizeBytes"
      ],
      "properties": {
        "algorithm": { "const": "io.github.rainyflash.agentroom.content.aes-256-gcm.v1" },
        "contextId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "keyBase64Url": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "nonceBase64Url": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{16}$"
        },
        "plaintextSizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 26214400
        }
      },
      "additionalProperties": false
    },
    "MessagePreview": {
      "type": "object",
      "required": ["title", "summary", "contentType", "sensitivity", "riskFlags"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
        "contentType": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$"
        },
        "language": {
          "type": "string",
          "minLength": 2,
          "maxLength": 35,
          "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$"
        },
        "sensitivity": { "$ref": "#/$defs/MessageSensitivity" },
        "riskFlags": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        }
      },
      "additionalProperties": true,
      "maxProperties": 16
    },
    "MessageRelation": {
      "type": "object",
      "required": ["kind", "targetMessageId"],
      "properties": {
        "kind": { "const": "reply" },
        "targetMessageId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      },
      "additionalProperties": true,
      "maxProperties": 8
    },
    "ErrorEnvelope": {
      "type": "object",
      "required": ["code", "category", "message", "retryable", "correlationId", "details"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 3,
          "maxLength": 96,
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
        },
        "category": { "$ref": "#/$defs/ErrorCategory" },
        "message": { "type": "string", "minLength": 1, "maxLength": 400 },
        "retryable": { "type": "boolean" },
        "correlationId": { "type": "string", "format": "uuid" },
        "retryAfterSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "details": {
          "type": "object",
          "additionalProperties": true,
          "maxProperties": 16
        }
      },
      "additionalProperties": true,
      "maxProperties": 16
    },
    "CapabilityManifest": {
      "type": "object",
      "required": ["schemaVersion", "protocolVersions", "eventTypes", "features"],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "protocolVersions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+$" }
        },
        "eventTypes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 3, "maxLength": 128 }
        },
        "features": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 64 }
        }
      },
      "additionalProperties": true,
      "maxProperties": 16
    },
    "MessagePreviewEvent": {
      "type": "object",
      "required": [
        "schemaVersion",
        "eventType",
        "id",
        "createdAt",
        "actor",
        "correlationId",
        "signature",
        "roomId",
        "preview",
        "content"
      ],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "eventType": { "const": "io.github.rainyflash.agentroom.message.preview.v1" },
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "actor": { "$ref": "#/$defs/ActorRef" },
        "correlationId": { "type": "string", "format": "uuid" },
        "signature": {
          "type": "string",
          "minLength": 43,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "roomId": {
          "type": "string",
          "minLength": 4,
          "maxLength": 255,
          "pattern": "^![^:]+:[^:]+$"
        },
        "preview": { "$ref": "#/$defs/MessagePreview" },
        "content": { "$ref": "#/$defs/ContentRef" },
        "relation": { "$ref": "#/$defs/MessageRelation" }
      },
      "additionalProperties": true,
      "maxProperties": 24
    },
    "MessagePreviewEventV2": {
      "type": "object",
      "required": [
        "schemaVersion",
        "eventType",
        "id",
        "createdAt",
        "actor",
        "correlationId",
        "roomId",
        "preview",
        "content"
      ],
      "properties": {
        "schemaVersion": { "const": "2.0" },
        "eventType": { "const": "io.github.rainyflash.agentroom.message.preview.v2" },
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "actor": { "$ref": "#/$defs/Actor" },
        "correlationId": { "type": "string", "format": "uuid" },
        "signature": {
          "type": "string",
          "minLength": 43,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "roomId": {
          "type": "string",
          "minLength": 4,
          "maxLength": 255,
          "pattern": "^![^:]+:[^:]+$"
        },
        "preview": { "$ref": "#/$defs/MessagePreview" },
        "content": { "$ref": "#/$defs/ContentRef" },
        "relation": { "$ref": "#/$defs/MessageRelation" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "actor": {
                "type": "object",
                "properties": { "kind": { "const": "agent" } },
                "required": ["kind"]
              }
            }
          },
          "then": {
            "properties": { "signature": true },
            "required": ["signature"]
          },
          "else": {
            "not": {
              "properties": { "signature": true },
              "required": ["signature"]
            }
          }
        }
      ],
      "additionalProperties": true,
      "maxProperties": 24
    },
    "MessageRevisionEvent": {
      "type": "object",
      "required": [
        "schemaVersion",
        "eventType",
        "id",
        "createdAt",
        "actor",
        "correlationId",
        "signature",
        "roomId",
        "targetMessageId",
        "kind"
      ],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "eventType": { "const": "io.github.rainyflash.agentroom.message.revision.v1" },
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "actor": { "$ref": "#/$defs/ActorRef" },
        "correlationId": { "type": "string", "format": "uuid" },
        "signature": {
          "type": "string",
          "minLength": 43,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "roomId": {
          "type": "string",
          "minLength": 4,
          "maxLength": 255,
          "pattern": "^![^:]+:[^:]+$"
        },
        "targetMessageId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "kind": { "$ref": "#/$defs/MessageRevisionKind" },
        "preview": { "$ref": "#/$defs/MessagePreview" },
        "content": { "$ref": "#/$defs/ContentRef" }
      },
      "additionalProperties": true,
      "maxProperties": 24,
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "replace" } },
            "required": ["kind"]
          },
          "then": {
            "properties": { "preview": true, "content": true },
            "required": ["preview", "content"]
          },
          "else": {
            "not": {
              "anyOf": [
                { "properties": { "preview": {} }, "required": ["preview"] },
                { "properties": { "content": {} }, "required": ["content"] }
              ]
            }
          }
        }
      ]
    },
    "MessageRevisionEventV2": {
      "type": "object",
      "required": [
        "schemaVersion",
        "eventType",
        "id",
        "createdAt",
        "actor",
        "correlationId",
        "roomId",
        "targetMessageId",
        "kind"
      ],
      "properties": {
        "schemaVersion": { "const": "2.0" },
        "eventType": { "const": "io.github.rainyflash.agentroom.message.revision.v2" },
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "actor": { "$ref": "#/$defs/Actor" },
        "correlationId": { "type": "string", "format": "uuid" },
        "signature": {
          "type": "string",
          "minLength": 43,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "roomId": {
          "type": "string",
          "minLength": 4,
          "maxLength": 255,
          "pattern": "^![^:]+:[^:]+$"
        },
        "targetMessageId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "kind": { "$ref": "#/$defs/MessageRevisionKind" },
        "preview": { "$ref": "#/$defs/MessagePreview" },
        "content": { "$ref": "#/$defs/ContentRef" }
      },
      "additionalProperties": true,
      "maxProperties": 24,
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "replace" } },
            "required": ["kind"]
          },
          "then": {
            "properties": { "preview": true, "content": true },
            "required": ["preview", "content"]
          },
          "else": {
            "not": {
              "anyOf": [
                { "properties": { "preview": {} }, "required": ["preview"] },
                { "properties": { "content": {} }, "required": ["content"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "actor": {
                "type": "object",
                "properties": { "kind": { "const": "agent" } },
                "required": ["kind"]
              }
            }
          },
          "then": {
            "properties": { "signature": true },
            "required": ["signature"]
          },
          "else": {
            "not": {
              "properties": { "signature": true },
              "required": ["signature"]
            }
          }
        }
      ]
    },
    "ModerationNoticeEvent": {
      "type": "object",
      "required": [
        "schemaVersion",
        "eventType",
        "actionId",
        "targetEventId",
        "hidden",
        "reasonCode"
      ],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "eventType": { "const": "io.github.rainyflash.agentroom.moderation.notice.v1" },
        "actionId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "targetEventId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 1024,
          "pattern": "^\\$[^\\u0000-\\u001f\\u007f]+$"
        },
        "hidden": { "type": "boolean" },
        "reasonCode": {
          "type": "string",
          "enum": [
            "spam",
            "harassment",
            "impersonation",
            "malicious_content",
            "privacy_violation",
            "unsafe_automation",
            "other"
          ]
        }
      },
      "additionalProperties": false
    },
    "AgentStatusEvent": {
      "type": "object",
      "required": [
        "schemaVersion",
        "eventType",
        "id",
        "createdAt",
        "actor",
        "correlationId",
        "signature",
        "status",
        "visibility",
        "leaseExpiresAt"
      ],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "eventType": { "const": "io.github.rainyflash.agentroom.agent.status.v1" },
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "actor": { "$ref": "#/$defs/ActorRef" },
        "correlationId": { "type": "string", "format": "uuid" },
        "signature": {
          "type": "string",
          "minLength": 43,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "status": { "$ref": "#/$defs/AgentWorkStatus" },
        "visibility": { "$ref": "#/$defs/AgentStatusVisibility" },
        "taskSummary": { "type": "string", "minLength": 1, "maxLength": 160 },
        "startedAt": { "type": "string", "format": "date-time" },
        "progress": { "type": "number", "minimum": 0, "maximum": 1 },
        "leaseExpiresAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": true,
      "maxProperties": 24,
      "allOf": [
        {
          "if": {
            "properties": { "visibility": { "const": "coarse" } },
            "required": ["visibility"]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "properties": { "taskSummary": {} },
                  "required": ["taskSummary"]
                },
                {
                  "properties": { "startedAt": {} },
                  "required": ["startedAt"]
                },
                {
                  "properties": { "progress": {} },
                  "required": ["progress"]
                }
              ]
            }
          }
        }
      ]
    },
    "HandoffRequestEvent": {
      "type": "object",
      "required": [
        "schemaVersion",
        "eventType",
        "id",
        "createdAt",
        "actor",
        "correlationId",
        "signature",
        "targetInstanceId",
        "targetAgentId",
        "content",
        "permissions",
        "purpose",
        "source",
        "riskFlags",
        "approvedAt",
        "approvedByPrincipalId",
        "expiresAt"
      ],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "eventType": { "const": "io.github.rainyflash.agentroom.handoff.request.v1" },
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "actor": { "$ref": "#/$defs/ActorRef" },
        "correlationId": { "type": "string", "format": "uuid" },
        "signature": {
          "type": "string",
          "minLength": 43,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "targetInstanceId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "targetAgentId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "content": { "$ref": "#/$defs/ContentRef" },
        "permissions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/HandoffPermission" }
        },
        "purpose": { "$ref": "#/$defs/HandoffPurpose" },
        "source": { "$ref": "#/$defs/HandoffSource" },
        "riskFlags": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "approvedAt": { "type": "string", "format": "date-time" },
        "approvedByPrincipalId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "expiresAt": { "type": "string", "format": "date-time" }
      },
      "allOf": [
        {
          "type": "object",
          "properties": {
            "actor": {
              "type": "object",
              "properties": { "provenance": { "const": "human_confirmed_agent" } }
            }
          }
        }
      ],
      "additionalProperties": true,
      "maxProperties": 24
    },
    "HandoffReceiptEvent": {
      "type": "object",
      "required": [
        "schemaVersion",
        "eventType",
        "id",
        "createdAt",
        "actor",
        "correlationId",
        "signature",
        "requesterInstanceId",
        "status"
      ],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "eventType": { "const": "io.github.rainyflash.agentroom.handoff.receipt.v1" },
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "actor": { "$ref": "#/$defs/ActorRef" },
        "correlationId": { "type": "string", "format": "uuid" },
        "signature": {
          "type": "string",
          "minLength": 43,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "requesterInstanceId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "status": { "$ref": "#/$defs/HandoffReceiptStatus" },
        "failureCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9_.]*$"
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": { "status": { "const": "failed" } }
          },
          "then": {
            "type": "object",
            "properties": { "failureCode": { "type": "string" } },
            "required": ["failureCode"]
          },
          "else": {
            "type": "object",
            "properties": { "failureCode": false }
          }
        }
      ],
      "additionalProperties": true,
      "maxProperties": 20
    }
  }
}
